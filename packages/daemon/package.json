{
  "name": "@towa/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Towa Telegram daemon + towa CLI (run/stop/status/ping/logs).",
  "bin": {
    "towa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "towa.example.yaml",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w --incremental",
    "dev:node": "node --watch-path=./dist --watch-path=./towa.yaml --watch-preserve-output --enable-source-maps --inspect=127.0.0.1:11001 dist/main.js | pino-pretty --config .pino-prettyrc",
    "dev": "run-p build:w dev:node",
    "start": "node --enable-source-maps dist/main.js | pino-pretty --config .pino-prettyrc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towa/core": "workspace:*",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.8.3"
  }
}
