{
  "name": "@towa/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Towa Telegram daemon (+ stub towa CLI binary).",
  "bin": {
    "towa": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w --incremental",
    "libs:build": "pnpm -C ../.. --filter @towa/core run build",
    "libs:w": "pnpm -C ../.. --filter @towa/core run build:w",
    "dev:node": "node --watch-path=./dist --watch-preserve-output --enable-source-maps --inspect=127.0.0.1:11001 dist/main.js | pino-pretty --config .pino-prettyrc",
    "dev": "pnpm run libs:build && tsc && run-p build:w libs:w dev:node",
    "start": "node --enable-source-maps dist/main.js | pino-pretty --config .pino-prettyrc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towa/core": "workspace:*",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.8.3"
  }
}
