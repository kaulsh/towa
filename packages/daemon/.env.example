# Towa daemon — secrets only. Non-secret settings live in the YAML config file
# (see towa.example.yaml). Copy to `.env` and fill in values. Never commit `.env`.

# Optional: package scripts (`pnpm start` / `pnpm dev`) read this instead of
# `towa run --config-file <file>`:
TOWA_CONFIG_FILE=./towa.yaml

# Required: Telegram bot token (§7).
TELEGRAM_BOT_TOKEN=

# When models.chat / models.embedding use openai-compatible:
# OPENAI_API_KEY=sk-...

# When telegram.webhook is set in YAML and you want a secret token:
# TELEGRAM_WEBHOOK_SECRET=

# Optional Bearer auth for CLI → control HTTP (or control.token in YAML):
# TOWA_CONTROL_TOKEN=

# Optional control HTTP port (default 18741). Use the same value for the CLI
# when the daemon listens on a non-default port:
# TOWA_CONTROL_PORT=18741

# Optional: package scripts (`pnpm start` / `pnpm dev`) read this instead of
# `towa run --config-file`:
# TOWA_CONFIG_FILE=./towa.yaml
