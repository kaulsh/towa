# Telegram daemon — copy to `.env` and fill in values.
# Never commit `.env` (gitignored).

# --- Required: Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the single allow-listed private chat (§7).
# Tip: message @userinfobot or check getUpdates after messaging your bot.
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- SQLite ---
# Filesystem path for the durable DB (WAL mode). Relative to cwd when you start.
TOWA_DB_PATH=./towa.db

# --- Chat model (default: Ollama) ---
# TOWA_CHAT_PROVIDER=ollama | openai-compatible
TOWA_CHAT_PROVIDER=ollama
TOWA_CHAT_MODEL=llama3.1:8b
# OLLAMA_HOST=http://127.0.0.1:11434
# Optional override when the model id is not in the built-in registry (§8.3):
# TOWA_CHAT_CONTEXT_WINDOW=8192

# OpenAI-compatible chat (set TOWA_CHAT_PROVIDER=openai-compatible):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# TOWA_CHAT_MODEL=gpt-4o-mini

# --- Embedding model (default: local MiniLM via transformers.js) ---
# TOWA_EMBEDDING_PROVIDER=local | openai-compatible
TOWA_EMBEDDING_PROVIDER=local
# TOWA_EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
# For openai-compatible embeddings, dimensions are required:
# TOWA_EMBEDDING_PROVIDER=openai-compatible
# TOWA_EMBEDDING_MODEL=text-embedding-3-small
# TOWA_EMBEDDING_DIMENSIONS=1536

# --- Burst debounce (§6), milliseconds ---
# TOWA_DEBOUNCE_IDLE_MS=800
# TOWA_DEBOUNCE_MAX_WAIT_MS=5000

# Optional system prompt override:
# TOWA_SYSTEM_PROMPT=You are Towa, a personal AI assistant with long-term memory.
