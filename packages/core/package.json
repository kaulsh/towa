    "ollama": "^0.6.3",
    "openai": "^6.46.0",
    "pino": "^9.7.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "telegraf": "^4.16.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
