{
  "name": "@towa/telegram",
  "version": "0.1.0",
  "description": "Towa Telegram channel adapter (Telegraf).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w --incremental",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@towa/core": "workspace:*",
    "kysely": "^0.28.2",
    "pino": "^9.7.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "typescript": "^5.8.3"
  }
}
