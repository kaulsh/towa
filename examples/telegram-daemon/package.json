{
  "name": "@towa/telegram-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Telegram daemon smoke-test for the towa harness.",
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w --incremental",
    "towa:build": "pnpm -C ../.. run build",
    "towa:w": "pnpm -C ../.. run build:w",
    "dev:node": "node --watch-path=./dist --watch-preserve-output --enable-source-maps --inspect=127.0.0.1:11001 dist/main.js | pino-pretty --config .pino-prettyrc",
    "dev": "pnpm run towa:build && tsc && run-p build:w towa:w dev:node",
    "start": "node --enable-source-maps dist/main.js | pino-pretty --config .pino-prettyrc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.2",
    "towa": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.8.3"
  }
}
